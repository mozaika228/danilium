{
  "name": "danilium",
  "displayName": "Danilium Language Support",
  "description": "Syntax highlighting and basic editor support for Danilium source files.",
  "version": "0.1.0",
  "publisher": "mozaika228",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "danilium",
        "aliases": [
          "Danilium",
          "danilium"
        ],
        "extensions": [
          ".dnl"
        ],
        "configuration": "language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "danilium",
        "scopeName": "source.danilium",
        "path": "syntaxes/danilium.tmLanguage.json"
      }
    ]
  }
}
